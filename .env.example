# Shopify Storefront API
#
# Copy this file to `.env` and fill in the values. Vite only exposes variables
# prefixed with VITE_, and everything here ends up in the client bundle — that
# is expected for the Storefront API, which is designed to be called from the
# browser. NEVER put an Admin API token in this file.
#
# Where to get these:
#   Shopify admin → Settings → Apps and sales channels → Develop apps
#   → Create an app → Configure Storefront API scopes
#   → enable at minimum: unauthenticated_read_product_listings,
#     unauthenticated_write_checkouts, unauthenticated_read_checkouts
#   → Install app → copy the Storefront API access token.

# The .myshopify.com domain, not your custom domain.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API access token.
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Optional. Defaults to the version pinned in src/lib/shopify.ts.
# VITE_SHOPIFY_API_VERSION=2025-01
